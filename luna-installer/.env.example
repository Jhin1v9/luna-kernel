# ============================================
# Luna + Dashboard — Arquivo de Configuração
# ============================================
# Copie este arquivo para ~/.luna-kernel/.env e preencha seus valores.
# O instalador (install.sh) faz isso automaticamente via wizard.

# Token do bot Telegram (obtenha em @BotFather)
TELEGRAM_BOT_TOKEN=SEU_TOKEN_AQUI

# Caminho do Google Chrome instalado na máquina
LUNA_CHROME_PATH=/usr/bin/google-chrome

# Modo debug da Luna (true/false)
LUNA_DEBUG=false

# Timeout do Kimi em milissegundos (99999 = praticamente ilimitado)
KIMI_TIMEOUT=99999

# Máximo de páginas que o Kimi pode abrir
KIMI_MAX_PAGES=7

# Modo persistente do Kimi (mantém contexto entre mensagens)
KIMI_PERSISTENT_MODE=true

# Token JWT para comunicação interna entre serviços
# Deixe em branco para o instalador gerar automaticamente
INTERNAL_API_TOKEN=
