#!/bin/bash
# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  Luna Web + Dashboard + Telegram — Unified Installer Wizard (v1.0)        ║
# ║  One-command setup for Pai & Nonoke (and anyone else).                   ║
# ║                                                                           ║
# ║  IMPORTANTE: o repo luna-kernel é privado. Clone-o primeiro com           ║
# ║  suas credenciais GitHub e execute este script localmente:                ║
# ║                                                                           ║
# ║    git clone https://github.com/Jhin1v9/luna-kernel.git ~/.luna-kernel    ║
# ║    bash ~/.luna-kernel/install/lunawebdownload                             ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

set -euo pipefail

# ── Colors ──
B=$(tput bold 2>/dev/null || true)
R=$(tput setaf 1 2>/dev/null || true)
G=$(tput setaf 2 2>/dev/null || true)
Y=$(tput setaf 3 2>/dev/null || true)
C=$(tput setaf 6 2>/dev/null || true)
N=$(tput sgr0 2>/dev/null || true)

# ── Paths ──
KERNEL_DIR="${HOME}/.luna-kernel"
DASH_DIR="${HOME}/NEXO_DASHBOARD_PRO"
ENV_FILE="${KERNEL_DIR}/.env"
LOG_FILE="/tmp/lunawebdownload.log"

REPO_KERNEL="https://github.com/Jhin1v9/luna-kernel.git"
REPO_DASH="https://github.com/Jhin1v9/NexoDashboard.git"

# ── Banner ──
cat <<'BANNER'
🌙  LUNA WEB + DASHBOARD + TELEGRAM  —  Unified Installer
BANNER
echo ""

# ── Helpers ──
info()  { echo "${C}${B}[LUNA]${N} $*"; }
ok()    { echo "${G}${B}[OK]${N}  $*"; }
warn()  { echo "${Y}${B}[WARN]${N} $*"; }
err()   { echo "${R}${B}[ERR]${N} $*" >&2; }
die()   { err "$*"; exit 1; }

log() {
  local msg="[$(date '+%Y-%m-%d %H:%M:%S')] $*"
  echo "$msg" >> "$LOG_FILE"
}

require_cmd() {
  local cmd="$1"
  if ! command -v "$cmd" >/dev/null 2>&1; then
    die "Comando obrigatório não encontrado: ${B}$cmd${N}. Instale antes de continuar."
  fi
}

require_node_version() {
  local min="18"
  local ver
  ver=$(node --version | sed 's/v//;s/\..*//')
  if [ "$ver" -lt "$min" ]; then
    die "Node.js >= ${min} é obrigatório. Versão encontrada: $(node --version)"
  fi
}

ask() {
  local prompt="$1"
  local default="${2:-}"
  local value
  if [ -n "$default" ]; then
    read -rp "${prompt} [${default}]: " value
    value="${value:-$default}"
  else
    read -rp "${prompt}: " value
  fi
  echo "$value"
}

ask_secret() {
  local prompt="$1"
  local value
  read -rsp "${prompt}: " value
  echo ""
  echo "$value"
}

# ── Step 0: prerequisites ──
info "Verificando pré-requisitos..."
require_cmd git
require_cmd node
require_cmd npm
require_node_version

# Optional: install pm2 globally if missing
if ! command -v pm2 >/dev/null 2>&1; then
  warn "PM2 não encontrado. Tentando instalar globalmente..."
  npm install -g pm2 || die "Falha ao instalar PM2 globalmente."
fi
ok "Pré-requisitos OK (Node $(node --version), npm $(npm --version))"

# ── Step 1: clone or update repos ──
info "Preparando repositórios..."

clone_or_update() {
  local dir="$1"
  local repo="$2"
  local name="$3"

  if [ -d "$dir/.git" ]; then
    info "Atualizando ${name} em ${dir}..."
    cd "$dir"
    git fetch origin main --quiet
    git reset --hard origin/main || true
    git pull origin main --quiet
  else
    info "Clonando ${name}..."
    mkdir -p "$(dirname "$dir")"
    git clone "$repo" "$dir"
  fi
}

clone_or_update "$KERNEL_DIR" "$REPO_KERNEL" "luna-kernel"
clone_or_update "$DASH_DIR" "$REPO_DASH" "nexo-dashboard"
ok "Repositórios prontos."

# ── Step 2: interactive wizard ──
info "Assistente de configuração"
echo "────────────────────────────────────────────────────────────────"
echo "Preencha as configurações abaixo. Deixe em branco para usar"
echo "o valor sugerido entre [colchetes]."
echo ""

# Telegram token (required)
TG_TOKEN=""
while [ -z "$TG_TOKEN" ]; do
  TG_TOKEN=$(ask_secret "🔑 Token do bot Telegram (@BotFather)")
  if [ -z "$TG_TOKEN" ]; then
    warn "O token do Telegram é obrigatório para o bot funcionar."
  fi
done

CHROME_PATH=$(ask "🌐 Caminho do Google Chrome" "/usr/bin/google-chrome")
LUNA_DEBUG=$(ask "🐛 Modo debug Luna (true/false)" "false")
KIMI_TIMEOUT=$(ask "⏱️  Timeout Kimi (ms)" "99999")
KIMI_MAX_PAGES=$(ask "📄 Kimi max páginas" "7")

# Internal API token: generate if missing
if [ -f "$ENV_FILE" ]; then
  EXISTING_API_TOKEN=$(grep "^INTERNAL_API_TOKEN=" "$ENV_FILE" | cut -d= -f2- | head -n1 || true)
else
  EXISTING_API_TOKEN=""
fi

if [ -n "$EXISTING_API_TOKEN" ]; then
  API_TOKEN=$(ask "🔒 INTERNAL_API_TOKEN (deixe em branco para manter o atual)" "")
  API_TOKEN="${API_TOKEN:-$EXISTING_API_TOKEN}"
else
  # Generate a JWT-style token via node
  API_TOKEN=$(node -e "
const jwt = require('jsonwebtoken');
const payload = { id: 'service', name: 'Service Bot', role: 'admin' };
const secret = require('crypto').randomBytes(32).toString('hex');
console.log(jwt.sign(payload, secret, { expiresIn: '10y' }));
" 2>/dev/null || echo "")
  if [ -z "$API_TOKEN" ]; then
    warn "Não foi possível gerar INTERNAL_API_TOKEN automaticamente. Você pode gerar depois."
  fi
fi

info "Escrevendo ${ENV_FILE}..."
mkdir -p "$(dirname "$ENV_FILE")"

# Backup existing env if present
if [ -f "$ENV_FILE" ]; then
  cp "$ENV_FILE" "${ENV_FILE}.backup.$(date +%s)"
fi

cat > "$ENV_FILE" <<EOF
# Gerado automaticamente pelo lunawebdownload em $(date -Iseconds)
TELEGRAM_BOT_TOKEN=${TG_TOKEN}
LUNA_CHROME_PATH=${CHROME_PATH}
LUNA_DEBUG=${LUNA_DEBUG}
KIMI_TIMEOUT=${KIMI_TIMEOUT}
KIMI_MAX_PAGES=${KIMI_MAX_PAGES}
KIMI_PERSISTENT_MODE=true
EOF

if [ -n "$API_TOKEN" ]; then
  echo "INTERNAL_API_TOKEN=${API_TOKEN}" >> "$ENV_FILE"
fi

chmod 600 "$ENV_FILE"
ok "Arquivo .env criado em ${ENV_FILE}"

# Ensure dashboard also sees the env (symlink)
DASH_ENV="${DASH_DIR}/.env"
if [ -L "$DASH_ENV" ] || [ -f "$DASH_ENV" ]; then
  rm -f "$DASH_ENV"
fi
ln -s "$ENV_FILE" "$DASH_ENV"
ok "Link simbólico criado: ${DASH_ENV} -> ${ENV_FILE}"

# Also put a copy inside backend/ because some scripts look there
BACKEND_ENV="${DASH_DIR}/backend/.env"
if [ -L "$BACKEND_ENV" ] || [ -f "$BACKEND_ENV" ]; then
  rm -f "$BACKEND_ENV"
fi
ln -s "$ENV_FILE" "$BACKEND_ENV"
ok "Link simbólico criado: ${BACKEND_ENV} -> ${ENV_FILE}"

# ── Step 3: install dependencies ──
info "Instalando dependências Node... (isso pode demorar)"

cd "$KERNEL_DIR"
npm install >> "$LOG_FILE" 2>&1 || die "Falha ao instalar dependências em luna-kernel"

cd "$DASH_DIR"
npm install >> "$LOG_FILE" 2>&1 || die "Falha ao instalar dependências raiz do dashboard"

cd "$DASH_DIR/backend"
npm install >> "$LOG_FILE" 2>&1 || die "Falha ao instalar dependências do backend"

cd "$DASH_DIR/frontend"
npm install --legacy-peer-deps >> "$LOG_FILE" 2>&1 || die "Falha ao instalar dependências do frontend"

ok "Dependências instaladas."

# ── Step 4: build luna-web ──
info "Buildando luna-web..."
cd "$KERNEL_DIR/luna-web"
npm install >> "$LOG_FILE" 2>&1 || warn "Algumas dependências do luna-web podem ter falhado, tentando build mesmo assim..."
npm run build >> "$LOG_FILE" 2>&1 || die "Falha ao buildar luna-web"
ok "luna-web buildado em ${KERNEL_DIR}/luna-web/dist"

# ── Step 5: PM2 ecosystem ──
info "Configurando PM2..."

ECO_FILE="${KERNEL_DIR}/pm2-ecosystem.config.js"
ECO_TEMPLATE="${KERNEL_DIR}/pm2-ecosystem.config.template.js"

if [ ! -f "$ECO_TEMPLATE" ]; then
  die "Template PM2 não encontrado em ${ECO_TEMPLATE}. O repositório pode estar incompleto."
fi

sed -e "s|{{HOME}}|${HOME}|g" \
    -e "s|{{NEXO_DASHBOARD_DIR}}|${DASH_DIR}|g" \
    "$ECO_TEMPLATE" > "$ECO_FILE"

ok "PM2 ecosystem gerado em ${ECO_FILE}"

# Rotate old PM2 logs to avoid false positives
for proc in luna-server nexo-dashboard telegram-bot; do
  for suffix in out error; do
    logf="${HOME}/.pm2/logs/${proc}-${suffix}.log"
    if [ -f "$logf" ]; then
      mv "$logf" "${logf}.old.$(date +%s)" 2>/dev/null || true
    fi
  done
done

pm2 delete luna-server nexo-dashboard telegram-bot 2>/dev/null || true
pm2 start "$ECO_FILE"
pm2 save
ok "PM2 configurado e serviços iniciados."

# ── Step 6: auto-update (cron) ──
info "Configurando atualização automática..."

SYNC_SCRIPT_SRC="${KERNEL_DIR}/luna-sync.sh"
SYNC_SCRIPT_DST="${HOME}/luna-sync.sh"

if [ -f "$SYNC_SCRIPT_SRC" ]; then
  cp "$SYNC_SCRIPT_SRC" "$SYNC_SCRIPT_DST"
  chmod +x "$SYNC_SCRIPT_DST"

  # Ensure directories inside luna-sync.sh match this user's HOME
  sed -i "s|/home/[^/]*|${HOME}|g" "$SYNC_SCRIPT_DST"

  # Install cron if not already present
  CRON_LINE="*/5 * * * * ${SYNC_SCRIPT_DST} >> /tmp/luna-sync.log 2>&1"
  if ! crontab -l 2>/dev/null | grep -qF "$SYNC_SCRIPT_DST"; then
    (crontab -l 2>/dev/null || true; echo "$CRON_LINE") | crontab -
    ok "Cron instalado: atualização automática a cada 5 minutos."
  else
    ok "Cron já configurado."
  fi
else
  warn "luna-sync.sh não encontrado em ${SYNC_SCRIPT_SRC}. Auto-update não configurado."
fi

# ── Step 7: final summary ──
echo ""
echo "${G}${B}════════════════════════════════════════════════════════════════${N}"
echo "${G}${B}  🌙 Luna instalada e rodando!${N}"
echo "${G}${B}════════════════════════════════════════════════════════════════${N}"
echo ""
echo "  Serviços PM2:"
pm2 list | tail -n +4 | head -10 || true
echo ""
echo "  Comandos úteis:"
echo "    ${B}pm2 logs telegram-bot --lines 50${N}   # logs do bot"
echo "    ${B}pm2 logs luna-server --lines 50${N}    # logs da Luna"
echo "    ${B}pm2 logs nexo-dashboard --lines 50${N} # logs do dashboard"
echo "    ${B}~/luna-sync.sh${N}                      # sync manual"
echo "    ${B}tail -f /tmp/luna-sync.log${N}          # log de sync"
echo ""
echo "  Env: ${B}${ENV_FILE}${N}"
echo "  PM2: ${B}${ECO_FILE}${N}"
echo ""
echo "  Para testar o bot, envie /kimi on no Telegram e converse."
echo ""
